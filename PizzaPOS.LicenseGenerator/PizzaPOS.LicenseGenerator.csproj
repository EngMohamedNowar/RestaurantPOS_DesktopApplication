<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PizzaPOS.LicenseGenerator</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!--Shared صيغة الـ payload ومنطق التوقيع/التحقق. -->
    <Compile Include="..\PizzaPOS\Services\LicenseSignature.cs" Link="LicenseSignature.cs" />

    <!--
      HardwareId.cs ما بتتشركش عن قصد: الأداة بتاخد الـ HWID كـ argument من
      المستخدم (مش بتقراش registry الجهاز نفسه). ربطها كان بيخلي الأداة تقرأ
      الجهاز اللي شغال عليها، مش جهاز العميل.
    -->
  </ItemGroup>
</Project>
