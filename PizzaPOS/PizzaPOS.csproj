<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>pizza.ico</ApplicationIcon>
	</PropertyGroup>
	<ItemGroup>
		<!--
			System.Drawing.Common و System.Text.Encoding.CodePages اتشالوا من هنا:
			الـ Windows Desktop SDK في .NET 10 بيجيبهم لوحده (NU1510)، و
			System.Text.Encoding.CodePages مفيش أي usage له في الكود أصلاً.
		-->
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
		<PackageReference Include="System.IO.Ports" Version="10.0.11" />
		<PackageReference Include="ClosedXML" Version="0.105.1" />
	</ItemGroup>
	<ItemGroup>
		<Resource Include="pizza.ico" />
	</ItemGroup>
	<ItemGroup>
		<!--
			اختبارات الترخيص محتاجة تقرا/تكتب license.dat مؤقتة. من غير ده
			هتكتب على الترخيص الحقيقي في %AppData% وتمسحه.
			الـ override كله internal، فمش بيفتح باب جديد في production.
		-->
		<InternalsVisibleTo Include="PizzaPOS.Tests" />
	</ItemGroup>
</Project>
