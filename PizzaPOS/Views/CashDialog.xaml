<Window x:Class="PizzaPOS.Views.CashDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الدفع كاش" Height="640" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0a0a14" FlowDirection="RightToLeft" FontFamily="Tahoma"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="NumBtn" TargetType="Button">
            <Setter Property="Margin"          Value="3"/>
            <Setter Property="FontSize"        Value="17"/>
            <Setter Property="FontWeight"      Value="Black"/>
            <Setter Property="Background"      Value="#12192e"/>
            <Setter Property="Foreground"      Value="#eef0f2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#1e2d4a"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1a2640"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E63946"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickBtn" TargetType="Button" BasedOn="{StaticResource NumBtn}">
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Foreground"  Value="#ffd166"/>
            <Setter Property="Background"  Value="#1a1f35"/>
            <Setter Property="BorderBrush" Value="#2a3a5c"/>
            <Setter Property="Margin"      Value="3"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontWeight"      Value="Black"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.3"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- title -->
            <RowDefinition Height="80"/>
            <!-- amounts -->
            <RowDefinition Height="46"/>
            <!-- quick btns -->
            <RowDefinition Height="*"/>
            <!-- numpad -->
            <RowDefinition Height="60"/>
            <!-- change -->
            <RowDefinition Height="52"/>
            <!-- action btns -->
        </Grid.RowDefinitions>

        <!-- ══ Title ══ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    Margin="0,0,0,12" VerticalAlignment="Center">
            <Border Background="#FF6B35" CornerRadius="8"
                    Width="32" Height="32" Margin="0,0,10,0">
                <TextBlock Text="💵" FontSize="17"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="الدفع كاش" FontSize="19" FontWeight="Black"
                       Foreground="#eef0f2" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ══ المطلوب / المدفوع ══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0d1525" CornerRadius="10"
                    BorderBrush="#1e2d4a" BorderThickness="1" Padding="12,8">
                <StackPanel>
                    <TextBlock Text="المطلوب" Foreground="#4a6080"
                               FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="TotalTxt" FontSize="20" FontWeight="Black"
                               Foreground="#E63946" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#0d1525" CornerRadius="10"
                    BorderBrush="#1e2d4a" BorderThickness="1" Padding="12,8">
                <StackPanel>
                    <TextBlock Text="المدفوع" Foreground="#4a6080"
                               FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="PaidTxt" Text="—" FontSize="20"
                               FontWeight="Black" Foreground="#ffd166" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ Quick Amount Buttons ══ -->
        <UniformGrid Grid.Row="2" Rows="1" Columns="5" Margin="0,6,0,0">
            <Button Content="50 ج"    Tag="Q50"   Click="Num_Click"
                    Style="{StaticResource QuickBtn}" Padding="0,10"/>
            <Button Content="100 ج"   Tag="Q100"  Click="Num_Click"
                    Style="{StaticResource QuickBtn}" Padding="0,10"/>
            <Button Content="200 ج"   Tag="Q200"  Click="Num_Click"
                    Style="{StaticResource QuickBtn}" Padding="0,10"/>
            <Button Content="500 ج"   Tag="Q500"  Click="Num_Click"
                    Style="{StaticResource QuickBtn}" Padding="0,10"/>
            <Button Content="✔ بالكامل" Tag="EXACT" Click="Num_Click"
                    Style="{StaticResource QuickBtn}" Padding="0,10"
                    Foreground="#06d6a0" BorderBrush="#06d6a0"/>
        </UniformGrid>

        <!-- ══ Numpad ══ -->
        <UniformGrid Grid.Row="3" Rows="4" Columns="4" Margin="0,6,0,0">
            <!-- Row 1 -->
            <Button Content="7"  Tag="7"  Click="Num_Click"
                    Style="{StaticResource NumBtn}"/>
            <Button Content="8"  Tag="8"  Click="Num_Click"
                    Style="{StaticResource NumBtn}"/>
            <Button Content="9"  Tag="9"  Click="Num_Click"
                    Style="{StaticResource NumBtn}"/>
            <Button Content="⌫" Tag="B"  Click="Num_Click"
                    Style="{StaticResource NumBtn}"
                    Background="#1a1030" Foreground="#E63946" BorderBrush="#E63946"/>
            <!-- Row 2 -->
            <Button Content="4"  Tag="4"  Click="Num_Click"
                    Style="{StaticResource NumBtn}"/>
            <Button Content="5"  Tag="5"  Click="Num_Click"
                    Style="{StaticResource NumBtn}"/>
            <Button Content="6"  Tag="6"  Click="Num_Click"
                    Style="{StaticResource NumBtn}"/>
            <Button Content="C"  Tag="C"  Click="Num_Click"
                    Style="{StaticResource NumBtn}"
                    Background="#1a1030" Foreground="#E63946" BorderBrush="#E63946"/>
            <!-- Row 3 -->
            <Button Content="1"  Tag="1"  Click="Num_Click"
                    Style="{StaticResource NumBtn}"/>
            <Button Content="2"  Tag="2"  Click="Num_Click"
                    Style="{StaticResource NumBtn}"/>
            <Button Content="3"  Tag="3"  Click="Num_Click"
                    Style="{StaticResource NumBtn}"/>
            <Button Content="00" Tag="00" Click="Num_Click"
                    Style="{StaticResource NumBtn}" Foreground="#8892a4"/>
            <!-- Row 4 -->
            <Button Content="."  Tag="."  Click="Num_Click"
                    Style="{StaticResource NumBtn}" Foreground="#8892a4"/>
            <Button Content="0"  Tag="0"  Click="Num_Click"
                    Style="{StaticResource NumBtn}"/>
            <Border/>
            <Button Content="↵"  Tag="ENTER" Click="Num_Click"
                    Style="{StaticResource NumBtn}"
                    Background="#06d6a0" Foreground="#0a0a14" BorderBrush="#06d6a0">
                <Button.Effect>
                    <DropShadowEffect Color="#06d6a0" BlurRadius="14"
                                      ShadowDepth="0" Opacity="0.5"/>
                </Button.Effect>
            </Button>
        </UniformGrid>

        <!-- ══ الباقي ══ -->
        <Border Grid.Row="4" CornerRadius="10" Margin="0,8,0,0"
                BorderThickness="1" BorderBrush="#1e3a2e">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0d2b1e" Offset="0"/>
                    <GradientStop Color="#081a12" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="14,0">
                <TextBlock Text="الباقي" Foreground="#4a8060" FontSize="11"
                           FontWeight="Bold" HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="ChangeTxt" Text="—"
                           FontSize="22" FontWeight="Black"
                           Foreground="#06d6a0" HorizontalAlignment="Left"
                           VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#06d6a0" BlurRadius="12"
                                          ShadowDepth="0" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ══ Action Buttons ══ -->
        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="إلغاء" Click="Cancel_Click"
                    Style="{StaticResource ActionBtn}"
                    Background="#12192e" Foreground="#8892a4"
                    FontSize="13" FontWeight="Bold" Padding="0,14"
                    BorderThickness="1" BorderBrush="#1e2d4a"/>

            <Button x:Name="ConfirmBtn" Grid.Column="2"
                    Content="✅ تأكيد الدفع" Click="Confirm_Click"
                    Style="{StaticResource ActionBtn}"
                    Background="#06d6a0" Foreground="#0a0a14"
                    FontSize="14" Padding="0,14" IsEnabled="False">
                <Button.Effect>
                    <DropShadowEffect Color="#06d6a0" BlurRadius="16"
                                      ShadowDepth="0" Opacity="0.5"/>
                </Button.Effect>
            </Button>
        </Grid>
    </Grid>
</Window>