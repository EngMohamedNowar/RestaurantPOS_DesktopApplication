<Window x:Class="PizzaPOS.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل الدخول"
        Height="680" Width="420"
        MinHeight="580" MinWidth="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#0a0a14"
        FlowDirection="RightToLeft"
        FontFamily="Tahoma"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="PinBtn" TargetType="Button">
            <Setter Property="Margin"          Value="4"/>
            <Setter Property="FontSize"        Value="17"/>
            <Setter Property="FontWeight"      Value="Black"/>
            <Setter Property="Background"      Value="#0f1526"/>
            <Setter Property="Foreground"      Value="#eef0f2"/>
            <Setter Property="BorderBrush"     Value="#1e2d4a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000" BlurRadius="6"
                                                  ShadowDepth="1" Opacity="0.2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation
                                            Storyboard.TargetName="bd"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#1a2640" Duration="0:0:0.1"/>
                                        <ColorAnimation
                                            Storyboard.TargetName="bd"
                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                            To="#FF6B35" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation
                                            Storyboard.TargetName="bd"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#0f1526" Duration="0:0:0.1"/>
                                        <ColorAnimation
                                            Storyboard.TargetName="bd"
                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                            To="#1e2d4a" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Button.Click">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation
                                            Storyboard.TargetName="bd"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#E63946" Duration="0:0:0.07"
                                            AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Top Accent Bar ══ -->
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF6B35" Offset="0"/>
                    <GradientStop Color="#E63946" Offset="0.5"/>
                    <GradientStop Color="#FF6B35" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- ══ Main Content — ScrollViewer يضمن الظهور على شاشات صغيرة ══ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,16,28,24">

                <!-- Logo -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border Background="#FF6B35" CornerRadius="16"
                            Width="56" Height="56"
                            HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF6B35" BlurRadius="18"
                                              ShadowDepth="0" Opacity="0.7"/>
                        </Border.Effect>
                        <TextBlock Text="🍕" FontSize="30"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="NAPOLI" FontSize="22" FontWeight="Black"
                               Foreground="#FF6B35" HorizontalAlignment="Center"
                               FontFamily="Segoe UI Black">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FF6B35" BlurRadius="10"
                                              ShadowDepth="0" Opacity="0.4"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="POS-System" FontSize="10"
                               Foreground="#4a6080" HorizontalAlignment="Center"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Username Label -->
                <TextBlock Text="اسم المستخدم" Foreground="#4a6080"
                           FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>

                <!-- Username Field -->
                <Border Background="#0f1526" BorderBrush="#1e2d4a"
                        BorderThickness="1" CornerRadius="10" Margin="0,0,0,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=UsernameBox, Path=IsFocused}" Value="True">
                                    <Setter Property="BorderBrush" Value="#FF6B35"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#FF6B35" BlurRadius="8"
                                                              ShadowDepth="0" Opacity="0.3"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBox x:Name="UsernameBox"
                             Background="Transparent"
                             Foreground="#eef0f2"
                             BorderThickness="0"
                             Padding="12,9"
                             FontSize="13"
                             CaretBrush="#FF6B35"
                             SelectionBrush="#FF6B35"/>
                </Border>

                <!-- PIN Label -->
                <TextBlock Text="الرقم السري (PIN)" Foreground="#4a6080"
                           FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>

                <!-- PIN Display -->
                <Border Background="#0f1526" BorderBrush="#1e2d4a"
                        BorderThickness="1" CornerRadius="10"
                        Padding="12,10" Margin="0,0,0,10">
                    <Grid>
                        <TextBlock x:Name="PinPlaceholder"
                                   Text="أدخل الـ PIN"
                                   Foreground="#2a3a5c" FontSize="13"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <!-- PIN Dots -->
                        <StackPanel x:Name="PinDots"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Visibility="Collapsed">
                            <Ellipse x:Name="Dot1" Width="13" Height="13"
                                     Fill="#1e2d4a" Margin="6,0"/>
                            <Ellipse x:Name="Dot2" Width="13" Height="13"
                                     Fill="#1e2d4a" Margin="6,0"/>
                            <Ellipse x:Name="Dot3" Width="13" Height="13"
                                     Fill="#1e2d4a" Margin="6,0"/>
                            <Ellipse x:Name="Dot4" Width="13" Height="13"
                                     Fill="#1e2d4a" Margin="6,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- PIN Pad -->
                <UniformGrid Rows="4" Columns="3" Margin="0,0,0,10">
                    <Button Content="1" Tag="1" Click="PinBtn_Click"
                            Style="{StaticResource PinBtn}" Padding="0,12"/>
                    <Button Content="2" Tag="2" Click="PinBtn_Click"
                            Style="{StaticResource PinBtn}" Padding="0,12"/>
                    <Button Content="3" Tag="3" Click="PinBtn_Click"
                            Style="{StaticResource PinBtn}" Padding="0,12"/>
                    <Button Content="4" Tag="4" Click="PinBtn_Click"
                            Style="{StaticResource PinBtn}" Padding="0,12"/>
                    <Button Content="5" Tag="5" Click="PinBtn_Click"
                            Style="{StaticResource PinBtn}" Padding="0,12"/>
                    <Button Content="6" Tag="6" Click="PinBtn_Click"
                            Style="{StaticResource PinBtn}" Padding="0,12"/>
                    <Button Content="7" Tag="7" Click="PinBtn_Click"
                            Style="{StaticResource PinBtn}" Padding="0,12"/>
                    <Button Content="8" Tag="8" Click="PinBtn_Click"
                            Style="{StaticResource PinBtn}" Padding="0,12"/>
                    <Button Content="9" Tag="9" Click="PinBtn_Click"
                            Style="{StaticResource PinBtn}" Padding="0,12"/>
                    <Button Content="مسح" Tag="C" Click="PinBtn_Click"
                            Style="{StaticResource PinBtn}" Padding="0,12"
                            Background="#1a1030" Foreground="#E63946"
                            BorderBrush="#E63946"/>
                    <Button Content="0" Tag="0" Click="PinBtn_Click"
                            Style="{StaticResource PinBtn}" Padding="0,12"/>
                    <Button Content="⌫" Tag="B" Click="PinBtn_Click"
                            Style="{StaticResource PinBtn}" Padding="0,12"
                            Background="#1a1030" Foreground="#E63946"
                            BorderBrush="#E63946"/>
                </UniformGrid>

                <!-- Error Message -->
                <TextBlock x:Name="ErrText" Text=""
                           Foreground="#E63946" FontSize="12"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <!-- Login Button -->
                <Button Content="دخول  ←" Click="Login_Click"
                        FontSize="14" FontWeight="Black"
                        Padding="0,13" BorderThickness="0"
                        Cursor="Hand" Background="#E63946"
                        Foreground="White">
                    <Button.Effect>
                        <DropShadowEffect Color="#E63946" BlurRadius="16"
                                          ShadowDepth="0" Opacity="0.5"/>
                    </Button.Effect>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation
                                                Storyboard.TargetName="bd"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#c1121f" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation
                                                Storyboard.TargetName="bd"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#E63946" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="Button.Click">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="bd"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0.7" Duration="0:0:0.08"
                                                AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>