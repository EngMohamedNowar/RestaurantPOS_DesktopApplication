<Window x:Class="PizzaPOS.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🍕 NAPOLI"
        Height="768" Width="1366"
        MinWidth="1024" MinHeight="680"
        WindowState="Maximized"
        Background="#0a0a14"
        FlowDirection="RightToLeft"
        FontFamily="Tahoma"
        Icon="/pizza.ico"
        Loaded="Window_Loaded">

    <Window.Resources>

        <ControlTemplate x:Key="RoundBtn" TargetType="Button">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.78"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ══ ProdCard ══ -->
        <Style x:Key="ProdCard" TargetType="Button">
            <Setter Property="BorderThickness"       Value="1.5"/>
            <Setter Property="Cursor"                Value="Hand"/>
            <Setter Property="Margin"                Value="4"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" Padding="8">
                            <Border.Effect>
                                <DropShadowEffect x:Name="glow"
                                    Color="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=DataContext.CardAccent}"
                                    BlurRadius="0" ShadowDepth="0" Opacity="0.75"/>
                            </Border.Effect>
                            <StackPanel>
                                <Border Background="{Binding CardIconBg}"
                                        CornerRadius="10"
                                        Padding="4" Margin="0,0,0,5"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" FontSize="28"
                                               HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="10" FontWeight="Bold"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="#dde4f0" Margin="0,0,0,5"/>
                                <Border Background="{Binding CardPriceBg}"
                                        CornerRadius="6"
                                        Padding="5,3" HorizontalAlignment="Center">
                                    <TextBlock FontSize="12" FontWeight="Black"
                                               TextAlignment="Center"
                                               Foreground="{Binding CardAccent}">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Border}, Path=DataContext.CardAccent}"
                                                BlurRadius="6" ShadowDepth="0" Opacity="0.6"/>
                                        </TextBlock.Effect>
                                        <Run Text="{Binding Price, StringFormat={}{0:F2}, Mode=OneWay}"/>
                                        <Run Text=" ج" FontSize="9"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="BlurRadius" To="20" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="BlurRadius" To="0" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Button.Click">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.95" Duration="0:0:0.06" AutoReverse="True"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.95" Duration="0:0:0.06" AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QtyBtn" TargetType="Button">
            <Setter Property="Width"           Value="24"/>
            <Setter Property="Height"          Value="24"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="Black"/>
            <Setter Property="Foreground"      Value="#ffffff"/>
            <Setter Property="Background"      Value="#1e2d4a"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#E63946" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#1e2d4a" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Button.Click">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.82" Duration="0:0:0.06" AutoReverse="True"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.82" Duration="0:0:0.06" AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTB" TargetType="TextBox">
            <Setter Property="Background"               Value="#0f1526"/>
            <Setter Property="Foreground"               Value="#ffffff"/>
            <Setter Property="BorderBrush"              Value="#2a3f6a"/>
            <Setter Property="BorderThickness"          Value="1.5"/>
            <Setter Property="Padding"                  Value="8,7"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="CaretBrush"               Value="#FF6B35"/>
            <Setter Property="SelectionBrush"           Value="#FF6B35"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FF6B35"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FF6B35" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PayBtn" TargetType="Button">
            <Setter Property="FontWeight"            Value="Bold"/>
            <Setter Property="FontSize"              Value="13"/>
            <Setter Property="BorderThickness"       Value="0"/>
            <Setter Property="Cursor"                Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000" BlurRadius="12" ShadowDepth="3" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.02" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.02" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Button.Click">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.96" Duration="0:0:0.06" AutoReverse="True"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.96" Duration="0:0:0.06" AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OTypeBtn" TargetType="RadioButton">
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Foreground"  Value="#b0c4de"/>
            <Setter Property="Background"  Value="#0a0f1c"/>
            <Setter Property="BorderBrush" Value="#2a3f6a"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1a2a10"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#06d6a0"/>
                                <Setter Property="Foreground" Value="#06d6a0"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked"   Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="#ffffff"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4a6080"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- HeaderBtn موحد — Height=32, FontSize=11, Padding=10,0, بدون Width ثابت -->
        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Height"          Value="32"/>
            <Setter Property="MinWidth"        Value="60"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontFamily"      Value="Tahoma"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Background"      Value="#1a2640"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="Template"        Value="{StaticResource RoundBtn}"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background"      Value="#0d1525"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="10,5"/>
            <Setter Property="Margin"          Value="0,0,6,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#1e2d4a"/>
        </Style>

        <!-- مجموعة أزرار في الناف بار -->
        <Style x:Key="NavGroup" TargetType="Border">
            <Setter Property="Background"      Value="#0a1120"/>
            <Setter Property="CornerRadius"    Value="9"/>
            <Setter Property="Padding"         Value="6,4"/>
            <Setter Property="Margin"          Value="0,0,2,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#16223c"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- فاصل رأسي بين المجموعات -->
        <Style x:Key="NavDiv" TargetType="Border">
            <Setter Property="Width"           Value="1"/>
            <Setter Property="Background"      Value="#23344f"/>
            <Setter Property="Margin"          Value="7,7,7,7"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ══ HEADER ══ -->
        <Border Grid.Row="0" BorderThickness="0,0,0,2" BorderBrush="#E63946">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0c1222" Offset="0"/>
                    <GradientStop Color="#15203c" Offset="0.5"/>
                    <GradientStop Color="#0c1222" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ══ Logo + Shop ══ -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FF6B35" CornerRadius="11" Width="40" Height="40" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF6B35" BlurRadius="14" ShadowDepth="0" Opacity="0.6"/>
                        </Border.Effect>
                        <TextBlock Text="🍕" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                        <TextBlock x:Name="ShopNameHeader" Text="NAPOLI" FontSize="17" FontWeight="Black"
                                   Foreground="#FF6B35" FontFamily="Segoe UI Black"/>
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <Ellipse Width="7" Height="7" Fill="#06d6a0" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="الشفت مفتوح" FontSize="9" Foreground="#5aaa80" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- ══ Stats + Groups ══ -->
                <ScrollViewer Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Hidden"
                              VerticalAlignment="Center" Margin="10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- إحصائيات -->
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="{Binding TodaySales, StringFormat={}{0:F0}}" FontSize="14" FontWeight="Black" Foreground="#06d6a0" HorizontalAlignment="Center"/>
                                <TextBlock Text="مبيعات (ج)" FontSize="8" Foreground="#b0c4de" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="{Binding TodayOrders}" FontSize="14" FontWeight="Black" Foreground="#ffd166" HorizontalAlignment="Center"/>
                                <TextBlock Text="أوردرات" FontSize="8" Foreground="#b0c4de" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="{Binding AvgOrder, StringFormat={}{0:F0}}" FontSize="14" FontWeight="Black" Foreground="#a78bfa" HorizontalAlignment="Center"/>
                                <TextBlock Text="متوسط" FontSize="8" Foreground="#b0c4de" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="BtnProfit" Background="#0d1f14" CornerRadius="8"
                                Padding="10,5" Margin="0,0,6,0" BorderThickness="1" BorderBrush="#1e3a2e">
                            <StackPanel>
                                <TextBlock Text="{Binding TodayProfit, StringFormat={}{0:F0}}" FontSize="14" FontWeight="Black" Foreground="#06d6a0" HorizontalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#06d6a0" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text="💰 ربح (ج)" FontSize="8" Foreground="#5aaa80" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="BtnLoss" Background="#1a0a0a" CornerRadius="8"
                                Padding="10,5" Margin="0,0,8,0" BorderThickness="1" BorderBrush="#3a1e1e">
                            <StackPanel>
                                <TextBlock Text="{Binding TodayLoss, StringFormat={}{0:F0}}" FontSize="14" FontWeight="Black" Foreground="#E63946" HorizontalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#E63946" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text="📉 خسائر (ج)" FontSize="8" Foreground="#aa5060" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NavDiv}"/>

                        <!-- إدارة -->
                        <Border Style="{StaticResource NavGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnCategories" Content="🗂 فئات"           Click="OpenCategories_Click"      Style="{StaticResource HeaderBtn}" Foreground="#fde68a" BorderBrush="#ffd166" Margin="0,0,4,0"/>
                                <Button x:Name="BtnProducts"   Content="📦 منتجات"         Click="OpenProducts_Click"        Style="{StaticResource HeaderBtn}" Foreground="#fde68a" BorderBrush="#ffd166" Margin="0,0,4,0"/>
                                <Button x:Name="BtnWarehouse"  Content="📦 مخزن"            Click="OpenWarehouse_Click"       Style="{StaticResource HeaderBtn}" Foreground="#fde68a" BorderBrush="#ffd166" Margin="0,0,4,0"/>
                                <Button x:Name="BtnOffers"     Content="🏷️ عروض"           Click="OpenOffers_Click"          Style="{StaticResource HeaderBtn}" Foreground="#ff8090" BorderBrush="#E63946"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NavDiv}"/>

                        <!-- أعمال -->
                        <Border Style="{StaticResource NavGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnReports"    Content="📊 تقارير"          Click="OpenReports_Click"         Style="{StaticResource HeaderBtn}" Foreground="#fde68a" BorderBrush="#ffd166" Margin="0,0,4,0"/>
                                <Button x:Name="BtnCustomers"  Content="👤 زبائن"           Click="OpenCustomers_Click"       Style="{StaticResource HeaderBtn}" Foreground="#c4b5fd" BorderBrush="#a78bfa" Margin="0,0,4,0"/>
                                <Button x:Name="BtnDrivers"    Content="🛵 سائقين"         Click="OpenDrivers_Click"         Style="{StaticResource HeaderBtn}" Foreground="#6effd4" BorderBrush="#06d6a0" Margin="0,0,4,0"/>
                                <Button x:Name="BtnUsers"      Content="👥 مستخدمين"      Click="OpenUsers_Click"           Style="{StaticResource HeaderBtn}" Foreground="#c4b5fd" BorderBrush="#a78bfa" Margin="0,0,4,0"/>
                                <Button x:Name="BtnSettings"   Content="⚙️ إعدادات"        Click="OpenSettings_Click"        Style="{StaticResource HeaderBtn}" Foreground="#c4b5fd" BorderBrush="#a78bfa"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NavDiv}"/>

                        <!-- عمليات -->
                        <Border Style="{StaticResource NavGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="⏸ معلق (F5)" Click="HeldOrders_Click"    Style="{StaticResource HeaderBtn}" Foreground="#6effd4" BorderBrush="#06d6a0" Margin="0,0,4,0"/>
                                <Button Content="📋 تتبع الأوردرات" Click="OpenTracking_Click" Style="{StaticResource HeaderBtn}" Foreground="#fde68a" BorderBrush="#FF6B35" Margin="0,0,4,0"/>
                                <Button Content="⏹ إغلاق شفت" Command="{Binding CloseShiftCmd}" Style="{StaticResource HeaderBtn}" Background="#2a1020" Foreground="#ff8090" BorderBrush="#E63946"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ══ Clock + User ══ -->
                <Border Grid.Column="2" Background="#0d1525" CornerRadius="9"
                        Padding="12,5" BorderThickness="1" BorderBrush="#1e2d4a" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ClockTxt" FontSize="14" FontWeight="Black" Foreground="#ffd166"
                                   FontFamily="Consolas" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DateTxt" FontSize="9" Foreground="#7d93b0" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        <TextBlock x:Name="UserTxt" FontSize="9" FontWeight="Bold" Foreground="#a78bfa" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══ MAIN ══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="500"/>
                <ColumnDefinition Width="300" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT -->
            <Grid Grid.Column="0" Background="#0a0a14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Categories -->
                <Border Grid.Row="0" Padding="10,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#111827" Offset="0"/>
                            <GradientStop Color="#0a0a14" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden">
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,6,0" Padding="14,6" Cursor="Hand"
                                            FontWeight="Bold" FontSize="12"
                                            Background="#0f1526" Foreground="#b0c8e8"
                                            BorderBrush="#2a3f6a" BorderThickness="1.5"
                                            Command="{Binding DataContext.SelectCatCmd, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Id}">
                                        <Button.Content>
                                            <TextBlock Text="{Binding Name}"/>
                                        </Button.Content>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="20" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#FF6B35" Duration="0:0:0.08"/>
                                                                <ColorAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#1a2030" Duration="0:0:0.08"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#2a3f6a" Duration="0:0:0.08"/>
                                                                <ColorAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#0f1526" Duration="0:0:0.08"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Search -->
                <Border Grid.Row="1" Padding="10,0,10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBox x:Name="SearchBox" Style="{StaticResource DarkTB}"
                                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            <TextBlock Text="🔍  ابحث عن منتج..." Foreground="#6b90b8" FontSize="12"
                                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Search}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Border Grid.Column="1" Background="#FF6B35" CornerRadius="10"
                                Padding="10,7" Margin="6,0,0,0" VerticalAlignment="Stretch">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF6B35" BlurRadius="10" ShadowDepth="0" Opacity="0.45"/>
                            </Border.Effect>
                            <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- ══ Products ══ -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="6,0,6,6">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Products.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="😕" FontSize="38" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="لا توجد منتجات مطابقة" Foreground="#7a9aaa" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Products}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ProdCard}"
                                            Width="135" Height="118"
                                            Background="{Binding CardColor}"
                                            BorderBrush="{Binding CardAccent}"
                                            Command="{Binding DataContext.AddProductCmd, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- RIGHT: Order Panel -->
            <Border Grid.Column="1" BorderBrush="#1e2d4a" BorderThickness="1,0,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0f1526" Offset="0"/>
                        <GradientStop Color="#0d1220" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Order Header -->
                    <Border Grid.Row="0" Padding="12,10" BorderBrush="#1e2d4a" BorderThickness="0,0,0,1" Background="#12192e">
                        <Grid>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <TextBlock Text="🧾" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="الأوردر الحالي" FontSize="13" FontWeight="Black" Foreground="#ffffff" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border CornerRadius="10" HorizontalAlignment="Left" Padding="8,3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#E63946" Offset="0"/>
                                        <GradientStop Color="#c1121f" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="{Binding OrderNumber}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Order Type -->
                    <Border Grid.Row="1" Padding="10,7" BorderBrush="#1e2d4a" BorderThickness="0,0,0,1" Background="#0a0f1c">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <RadioButton Content="🍽 صالة" GroupName="ot" Style="{StaticResource OTypeBtn}"
                                         Command="{Binding SetOrderTypeCmd}" CommandParameter="صالة">
                                <RadioButton.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="7,0,0,7"/>
                                    </Style>
                                </RadioButton.Resources>
                            </RadioButton>
                            <RadioButton Content="🥡 تيك أواي" GroupName="ot" Style="{StaticResource OTypeBtn}"
                                         Command="{Binding SetOrderTypeCmd}" CommandParameter="تيك أواي"/>
                            <RadioButton Content="🛵 ديلفري" GroupName="ot" IsChecked="True" Style="{StaticResource OTypeBtn}"
                                         Command="{Binding SetOrderTypeCmd}" CommandParameter="ديلفري">
                                <RadioButton.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="0,7,7,0"/>
                                    </Style>
                                </RadioButton.Resources>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- Order Items -->
                    <Grid Grid.Row="2">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="🛒" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="الأوردر فاضي" Foreground="#7a9aaa" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="اضغط على أي منتج لإضافته" Foreground="#5a7a9a" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,4">
                            <ItemsControl ItemsSource="{Binding OrderItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,3" BorderBrush="#2a3f62" BorderThickness="1" CornerRadius="9" Padding="8,7" Background="#111d36">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#0f1526" CornerRadius="7" Width="26" Height="26">
                                                    <TextBlock Text="{Binding Icon}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="6,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold" Foreground="#ffffff"/>
                                                    <TextBlock FontSize="9" Foreground="#06d6a0" Margin="0,1,0,0">
                                                        <Run Text="{Binding Price, StringFormat={}{0:F2}, Mode=OneWay}"/>
                                                        <Run Text=" ج" Foreground="#40c490"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding SizeAndExtrasDisplay}" FontSize="8" Foreground="#ffd166" TextWrapping="Wrap" Margin="0,1,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SizeAndExtrasDisplay}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource QtyBtn}" Content="−" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.DecQtyCmd, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Border Background="#0f1526" CornerRadius="5" MinWidth="24" Padding="3,2">
                                                        <TextBlock Text="{Binding Qty}" FontSize="12" FontWeight="Black" Foreground="#ffffff" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Button Style="{StaticResource QtyBtn}" Content="+" Margin="4,0,0,0"
                                                            Command="{Binding DataContext.IncQtyCmd, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                                <Border Grid.Column="3" Background="#0f1f14" CornerRadius="7" Padding="3,2" VerticalAlignment="Center" Margin="4,0">
                                                    <TextBlock FontSize="11" FontWeight="Black" Foreground="#06d6a0" TextAlignment="Center">
                                                        <Run Text="{Binding Subtotal, StringFormat={}{0:F2}, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Border>
                                                <Button Grid.Column="4" Content="✕" FontSize="10" Background="Transparent" BorderThickness="0"
                                                        Foreground="#7a9ab8" Cursor="Hand" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.RemoveItemCmd, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Foreground" Value="#E63946"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Notes + Discount -->
                    <StackPanel Grid.Row="3" Margin="10,5">
                        <Grid Margin="0,0,0,5">
                            <TextBox Style="{StaticResource DarkTB}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MaxLength="200">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="9"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            <TextBlock Text="📝  ملاحظات للمطبخ..." Foreground="#6b90b8" FontSize="12" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Notes}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,0,6,0">
                                <TextBox Style="{StaticResource DarkTB}" Text="{Binding DiscountInput, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="9"/>
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>
                                <TextBlock Text="🏷  خصم..." Foreground="#6b90b8" FontSize="12" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DiscountInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Grid.Column="1" Content="{Binding DiscSym}" Command="{Binding ToggleDiscCmd}"
                                    Background="#1a2640" Foreground="#ffd166" BorderBrush="#ffd166" BorderThickness="1.5"
                                    FontWeight="Black" FontSize="14" Cursor="Hand" Template="{StaticResource RoundBtn}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Totals -->
                    <Border Grid.Row="4" Margin="10,0" Padding="12,8" CornerRadius="10" BorderThickness="1" BorderBrush="#1e2d4a">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#0d1525" Offset="0"/>
                                <GradientStop Color="#080e1a" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="المجموع" Foreground="#b0c4de" FontSize="11" HorizontalAlignment="Right"/>
                                <TextBlock HorizontalAlignment="Left" Foreground="#c8d8f0" FontSize="11">
                                    <Run Text="{Binding Subtotal, StringFormat={}{0:F2}, Mode=OneWay}"/>
                                    <Run Text=" ج"/>
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Discount, Mode=OneWay}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <TextBlock Foreground="#b0c4de" FontSize="11" HorizontalAlignment="Right">
                                    <Run Text="خصم ("/><Run Text="{Binding DiscountInput, Mode=OneWay}"/><Run Text="{Binding DiscSym, Mode=OneWay}"/><Run Text=")"/>
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Left" Foreground="#ff7a85" FontSize="11">
                                    <Run Text="- "/><Run Text="{Binding Discount, StringFormat={}{0:F2}, Mode=OneWay}"/><Run Text=" ج"/>
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Foreground="#b0c4de" FontSize="11" HorizontalAlignment="Right">
                                    <Run Text="ضريبة ("/><Run Text="{Binding TaxRate, StringFormat={}{0:0.##}, Mode=OneWay}"/><Run Text="%)"/>
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Left" Foreground="#c8d8f0" FontSize="11">
                                    <Run Text="{Binding Tax, StringFormat={}{0:F2}, Mode=OneWay}"/><Run Text=" ج"/>
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ServiceCharge, Mode=OneWay}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <TextBlock Foreground="#b0c4de" FontSize="11" HorizontalAlignment="Right">
                                    <Run Text="خدمة ("/><Run Text="{Binding ServiceRate, StringFormat={}{0:0.##}, Mode=OneWay}"/><Run Text="%) "/>
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Left" Foreground="#c8d8f0" FontSize="11">
                                    <Run Text="{Binding ServiceCharge, StringFormat={}{0:F2}, Mode=OneWay}"/><Run Text=" ج"/>
                                </TextBlock>
                            </Grid>
                            <Border BorderBrush="#2a3f6a" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,6,0,0">
                                <Grid>
                                    <TextBlock Text="الإجمالي" Foreground="#ffffff" FontSize="18" FontWeight="Black" HorizontalAlignment="Right"/>
                                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                        <TextBlock Foreground="#06d6a0" FontSize="20" FontWeight="Black">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="#06d6a0" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>
                                            </TextBlock.Effect>
                                            <Run Text="{Binding Total, StringFormat={}{0:F2}, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text=" ج" Foreground="#3dba8a" FontSize="12" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Pay Buttons -->
                    <Grid Grid.Row="5" Margin="10,6,10,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Row="0" Grid.Column="0" Content="💵 كاش (F1)"
                                Command="{Binding PayCashCmd}" IsEnabled="{Binding HasItems}"
                                Style="{StaticResource PayBtn}" Padding="0,11" Margin="0,0,4,5"
                                Background="#06d6a0" Foreground="#040f0a">
                            <Button.Effect>
                                <DropShadowEffect Color="#06d6a0" BlurRadius="14" ShadowDepth="0" Opacity="0.4"/>
                            </Button.Effect>
                        </Button>
                        <Button Grid.Row="0" Grid.Column="1" Content="💳 فيزا (F2)"
                                Command="{Binding PayCardCmd}" IsEnabled="{Binding HasItems}"
                                Style="{StaticResource PayBtn}" Padding="0,11" Margin="4,0,0,5"
                                Background="#1e2d4a" Foreground="#e8f0ff" BorderBrush="#3a5080" BorderThickness="1"/>
                        <Button Grid.Row="1" Grid.Column="0" Content="⏸ تعليق (F3)"
                                Command="{Binding HoldCmd}" IsEnabled="{Binding HasItems}"
                                Style="{StaticResource PayBtn}" Padding="0,9" Margin="0,0,4,0"
                                Background="Transparent" Foreground="#fde68a" BorderBrush="#ffd166" BorderThickness="1.5"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="🗑 مسح (F4)"
                                Command="{Binding ClearCmd}" IsEnabled="{Binding HasItems}"
                                Style="{StaticResource PayBtn}" Padding="0,9" Margin="4,0,0,0"
                                Background="Transparent" Foreground="#ff8090" BorderBrush="#E63946" BorderThickness="1.5"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ══ STATUS BAR ══ -->
        <Border Grid.Row="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#080d18" Offset="0"/>
                    <GradientStop Color="#0d1220" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1e2d4a" Offset="0"/>
                    <GradientStop Color="#E63946" Offset="0.5"/>
                    <GradientStop Color="#1e2d4a" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>0,1,0,0</Border.BorderThickness>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                <Ellipse Width="6" Height="6" Margin="0,0,7,0">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="#06d6a0"/>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#06d6a0" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
                    </Ellipse.Effect>
                </Ellipse>
                <TextBlock x:Name="CashierStatusTxt" Foreground="#c0d4f0" FontSize="10" Margin="0,0,12,0"/>
                <TextBlock Text="│" Foreground="#2a3f6a" Margin="0,0,12,0"/>
                <TextBlock Foreground="#b0c4de" FontSize="10"
                           Text="F1=كاش  │  F2=فيزا  │  F3=تعليق  │  F4=مسح  │  F5=معلق  │  /=بحث"/>
                <TextBlock Text="│" Foreground="#2a3f6a" Margin="12,0,12,0"/>
                <TextBlock FontSize="9" Foreground="#3a4a6a" VerticalAlignment="Center">
                    Developed by <Run FontWeight="Bold" Foreground="#4a6080">Eng. Mohamed Nowar</Run>
                </TextBlock>
            </StackPanel>
        </Border>

    </Grid>
</Window>